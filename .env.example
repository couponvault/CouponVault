# Database
MONGODB_URI=mongodb://localhost:27017/couponvault
# or use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/couponvault

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Admin Credentials (initial setup)
ADMIN_EMAIL=admin@couponvault.com
ADMIN_PASSWORD=Admin@12345

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15

# Coupon Generation
DAILY_COUPON_BATCH_SIZE=100
AUTO_REFILL_THRESHOLD=20

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# External APIs (optional - for affiliate links)
AMAZON_AFFILIATE_TAG=your-tag
FLIPKART_AFFILIATE_TAG=your-tag
